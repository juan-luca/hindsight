# Environment
.venv/
__pycache__/
*.pyc
.DS_Store

# Relate store: only the snapshot (graph.json) and manifest.json travel in git.
# Locks and the WAL are per-machine runtime state, recreated on open.
graph/.cypherlite/
graph/.cypherlite.lock
graph/.cypherlite.writer
graph/wal/

# Local scratch
.hindsight/tmp/

# Packaging
*.egg-info/
build/

# `relate serve` with auth persists a token next to the store.
*.auth-token

# Terms that must never be published (one regex per line; see README › Privacy).
.hindsight/*.local
